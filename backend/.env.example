# ---- Core ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/audiobooks
REDIS_URL=redis://localhost:6379/0

# ---- Mistral ----
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_TTS_MODEL=voxtral-mini-tts-3-0
# One distinct Voxtral voice ID per gender, configurable
MISTRAL_TTS_VOICE_MALE=alexander
MISTRAL_TTS_VOICE_FEMALE=amelia
MISTRAL_TTS_CHUNK_CHARS=4500
MISTRAL_RPM_LIMIT=30
MISTRAL_RPM_WINDOW=60

# ---- Google Sign-In ----
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com

# ---- S3 / R2 ----
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
S3_BUCKET=history-audiobooks
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRY_SECONDS=3600

# ---- FCM ----
FCM_ENABLED=false
FCM_CREDENTIALS_JSON=

# ---- Seeding ----
CATALOG_SEED_DIR=./seed_catalog
